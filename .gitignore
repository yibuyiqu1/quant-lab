# ============================================================
#  .gitignore —— 哪些文件不进 Git 仓库
# ============================================================
#  重要规则：.gitignore 只对「还没被跟踪」的文件生效。
#  已 git add 过的文件，光加规则没用，必须先：
#      git rm -r --cached <路径>      （本地文件不会被删）
#  推送前自查：
#      .venv\Scripts\python.exe src\check_repo.py
# ============================================================

# ---------- 个人环境（每台机器都不一样，不该共享）----------
.venv/
venv/
.vscode/
.idea/
*.swp

# ---------- Python 缓存 ----------
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# ---------- 数据（体积大，且可由脚本重新下载/生成）----------
data/raw/*
data/clean/*
!data/raw/.gitkeep
!data/clean/.gitkeep

# ---------- 教材与讲义（体积大，且不适合公开转存他人材料）----------
资料库/
*.part

# ---------- 运行产生的中间产物 ----------
# 保留代表性图表与最终报告，其余不入库
reports/_*.json
reports/*_lecture.json
reports/*_lesson.json
reports/*_result.json
reports/figs/_*.png
*.log
